{
  "name": "play-by-play-vscode",
  "displayName": "Play-by-Play",
  "description": "Opens the play-by-play viewer beside the editor, to follow Claude's commands live.",
  "version": "1.0.0-alpha.7",
  "publisher": "diminishedprime",
  "license": "MIT",
  "engines": {
    "vscode": "^1.137.0"
  },
  "main": "./dist/main.js",
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm build"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.9.6",
    "@types/vscode": "^1.137.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "icon": "dist/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/diminishedprime/play-by-play.git"
  }
}
